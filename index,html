<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SentixTech Notification Plugin</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Orbitron and Inter Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700&family=Inter:wght@400;600&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            color: #ffffff;
        }
        h1, h2, h3 {
            font-family: 'Orbitron', sans-serif;
        }
        .neon-glow {
            box-shadow: 0 0 10px rgba(40, 167, 69, 0.8), 0 0 20px rgba(40, 167, 69, 0.4);
        }
        .neon-glow-blue {
            box-shadow: 0 0 10px rgba(23, 162, 184, 0.8), 0 0 20px rgba(23, 162, 184, 0.4);
        }
        .notification {
            animation: slideIn 0.35s cubic-bezier(0.21, 1.02, 0.73, 1);
        }
        @keyframes slideIn {
            from { transform: translateY(100px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }
        .hidden {
            display: none;
        }
    </style>
</head>
<body>
    <!-- Hero Section -->
    <section class="py-20 text-center bg-gradient-to-b from-gray-900 to-gray-800">
        <h1 class="text-5xl md:text-6xl font-bold text-white mb-4">Laravel Alert Notification Plugin</h1>
        <p class="text-xl md:text-2xl text-gray-300 mb-8 max-w-3xl mx-auto">
            Beautiful, customizable, and responsive alerts for your Laravel app.
        </p>
        <div class="flex justify-center gap-4">
            <button id="demo-btn" class="px-6 py-3 bg-green-600 text-white rounded-lg neon-glow hover:bg-green-700 transition duration-300">
                Try Demo
            </button>
            <a href="#installation" class="px-6 py-3 bg-blue-600 text-white rounded-lg neon-glow-blue hover:bg-blue-700 transition duration-300">
                Get Started
            </a>
        </div>
    </section>

    <!-- Notification Demo -->
    <div id="notification" class="hidden fixed bottom-5 right-5 p-4 rounded-lg border bg-green-600 border-green-800 text-white max-w-sm notification">
        <div class="flex justify-between items-center">
            <span>Welcome to SentixTech!</span>
            <button id="close-notification" class="text-white font-bold">×</button>
        </div>
    </div>

    <!-- Features Section -->
    <section class="py-16 px-4 md:px-8 bg-gray-900">
        <h2 class="text-4xl font-bold text-center text-white mb-12">Why Choose Us?</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto">
            <div class="p-6 bg-gray-800 rounded-lg border border-green-600 hover:shadow-green-600 transform hover:scale-105 transition duration-300">
                <h3 class="text-xl font-semibold text-white">Configurable Positions</h3>
                <p class="mt-2 text-gray-300">Place alerts at the top, bottom, or center with custom offsets.</p>
            </div>
            <div class="p-6 bg-gray-800 rounded-lg border border-red-600 hover:shadow-red-600 transform hover:scale-105 transition duration-300">
                <h3 class="text-xl font-semibold text-white">Multiple Color Themes</h3>
                <p class="mt-2 text-gray-300">Choose from success, error, warning, info, dark, and light themes.</p>
            </div>
            <div class="p-6 bg-gray-800 rounded-lg border border-blue-600 hover:shadow-blue-600 transform hover:scale-105 transition duration-300">
                <h3 class="text-xl font-semibold text-white">Laravel Integration</h3>
                <p class="mt-2 text-gray-300">Seamless setup with Blade directives, facades, and helper functions.</p>
            </div>
            <div class="p-6 bg-gray-800 rounded-lg border border-yellow-600 hover:shadow-yellow-600 transform hover:scale-105 transition duration-300">
                <h3 class="text-xl font-semibold text-white">Auto-dismiss</h3>
                <p class="mt-2 text-gray-300">Configurable timeouts with hover pause for user-friendly notifications.</p>
            </div>
            <div class="p-6 bg-gray-800 rounded-lg border border-gray-600 hover:shadow-gray-600 transform hover:scale-105 transition duration-300">
                <h3 class="text-xl font-semibold text-white">Responsive Design</h3>
                <p class="mt-2 text-gray-300">Looks stunning on mobile, tablet, and desktop.</p>
            </div>
            <div class="p-6 bg-gray-800 rounded-lg border border-gray-600 hover:shadow-gray-600 transform hover:scale-105 transition duration-300">
                <h3 class="text-xl font-semibold text-white">Session & Validation</h3>
                <p class="mt-2 text-gray-300">Automatic display of Laravel session messages and validation errors.</p>
            </div>
        </div>
    </section>

    <!-- Installation Section -->
    <section id="installation" class="py-16 px-4 md:px-8 bg-gray-800">
        <h2 class="text-4xl font-bold text-center text-white mb-12">Get Started in Minutes</h2>
        <div class="max-w-3xl mx-auto">
            <!-- Step 1 -->
            <div class="mb-4">
                <button class="toggle-btn w-full text-left p-4 bg-gray-700 rounded-lg hover:bg-gray-600 transition duration-300">
                    <h3 class="text-lg font-semibold">1. Install via Composer</h3>
                </button>
                <pre class="code-block hidden mt-2 p-4 bg-gray-900 rounded-lg text-sm text-gray-300 overflow-x-auto">
                    <code>composer require sentix/alert</code>
                </pre>
            </div>
            <!-- Step 2 -->
            <div class="mb-4">
                <button class="toggle-btn w-full text-left p-4 bg-gray-700 rounded-lg hover:bg-gray-600 transition duration-300">
                    <h3 class="text-lg font-semibold">2. Install NPM Dependencies</h3>
                </button>
                <pre class="code-block hidden mt-2 p-4 bg-gray-900 rounded-lg text-sm text-gray-300 overflow-x-auto">
                    <code>npm install</code>
                </pre>
            </div>
            <!-- Step 3 -->
            <div class="mb-4">
                <button class="toggle-btn w-full text-left p-4 bg-gray-700 rounded-lg hover:bg-gray-600 transition duration-300">
                    <h3 class="text-lg font-semibold">3. Add Service Provider</h3>
                </button>
                <pre class="code-block hidden mt-2 p-4 bg-gray-900 rounded-lg text-sm text-gray-300 overflow-x-auto">
                    <code>'providers' => [
    Alert\AlertNotificationServiceProvider::class,
]</code>
                </pre>
            </div>
            <!-- Step 4 -->
            <div class="mb-4">
                <button class="toggle-btn w-full text-left p-4 bg-gray-700 rounded-lg hover:bg-gray-600 transition duration-300">
                    <h3 class="text-lg font-semibold">4. Publish Configuration</h3>
                </button>
                <pre class="code-block hidden mt-2 p-4 bg-gray-900 rounded-lg text-sm text-gray-300 overflow-x-auto">
                    <code>php artisan vendor:publish --provider="Alert\AlertNotificationServiceProvider" --tag="config"</code>
                </pre>
            </div>
            <!-- Step 5 -->
            <div class="mb-4">
                <button class="toggle-btn w-full text-left p-4 bg-gray-700 rounded-lg hover:bg-gray-600 transition duration-300">
                    <h3 class="text-lg font-semibold">5. Publish Assets</h3>
                </button>
                <pre class="code-block hidden mt-2 p-4 bg-gray-900 rounded-lg text-sm text-gray-300 overflow-x-auto">
                    <code>php artisan vendor:publish --provider="Alert\AlertNotificationServiceProvider" --tag="assets"</code>
                </pre>
            </div>
            <!-- Step 6 -->
            <div class="mb-4">
                <button class="toggle-btn w-full text-left p-4 bg-gray-700 rounded-lg hover:bg-gray-600 transition duration-300">
                    <h3 class="text-lg font-semibold">6. Add Blade Directives</h3>
                </button>
                <pre class="code-block hidden mt-2 p-4 bg-gray-900 rounded-lg text-sm text-gray-300 overflow-x-auto">
                    <code>&lt;!DOCTYPE html&gt;
&lt;html&gt;
&lt;head&gt;
    &lt;title&gt;Your App&lt;/title&gt;
    @alertStyles
&lt;/head&gt;
&lt;body&gt;
    &lt;!-- Your content --&gt;
    @alertNotifications
    @alertScripts
&lt;/body&gt;
&lt;/html&gt;</code>
                </pre>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="py-16 px-4 md:px-8 bg-gray-900 text-center">
        <h2 class="text-4xl font-bold text-white mb-8">Get in Touch</h2>
        <p class="text-lg text-gray-300 mb-6">Have questions or need support? Reach out to us!</p>
        <div class="max-w-md mx-auto text-left">
            <p class="text-white mb-2"><strong>Phone/WhatsApp:</strong> +918302618469</p>
            <p class="text-white mb-2"><strong>Email:</strong> <a href="mailto:sentixtech@gmail.com" class="text-blue-400 hover:underline">sentixtech@gmail.com</a></p>
            <p class="text-white mb-6"><strong>Email:</strong> <a href="mailto:shambishnoi75@gmail.com" class="text-blue-400 hover:underline">shambishnoi75@gmail.com</a></p>
        </div>
    </section>

    <!-- Footer -->
    <footer class="py-8 bg-gray-800 text-center">
        <p class="text-gray-300">&copy; 2025 SentixTech. Licensed under the MIT License.</p>
        <div class="mt-4 flex justify-center gap-4">
            <a href="https://github.com/sentixtech/notification" class="text-blue-400 hover:text-blue-300">GitHub</a>
            <a href="#top" class="text-blue-400 hover:text-blue-300">Back to Top</a>
        </div>
    </footer>

    <script>
        // Toggle Installation Steps
        const toggleButtons = document.querySelectorAll('.toggle-btn');
        toggleButtons.forEach(button => {
            button.addEventListener('click', () => {
                const codeBlock = button.nextElementSibling;
                codeBlock.classList.toggle('hidden');
            });
        });

        // Notification Demo
        const demoButton = document.getElementById('demo-btn');
        const notification = document.getElementById('notification');
        const closeButton = document.getElementById('close-notification');

        demoButton.addEventListener('click', () => {
            notification.classList.remove('hidden');
            setTimeout(() => {
                notification.classList.add('hidden');
            }, 5000);
        });

        closeButton.addEventListener('click', () => {
            notification.classList.add('hidden');
        });
    </script>
</body>
</html>